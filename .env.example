# ==============================================================================
# NEUROCLIN BIOSCIENCES // AI CLUSTER CONFIGURATION (.env.example)
# ==============================================================================

# 1. Google Gemini API (Główny dostawca inferencji AI - @google/genai)
# Pobierz klucz z Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# 2. Groq API (Zapasowy dostawca odporny na awarie - Fail-Safe / Fallback Provider)
# Ultraszybki endpoint OpenAI-compatible dla modeli Llama/Mixtral.
# Pobierz darmowy klucz z Groq Console: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile